# Merge into the existing env; notification worker env remains unchanged.
WA_COMMAND_PROVIDER=greenapi
WA_COMMAND_INBOUND_SHARDS=4
WA_COMMAND_SEND_INTERVAL_MS=1000
WA_COMMAND_SEND_WAIT_MS=300000

# Required only for baileys. This session must be dedicated to commands.
WA_COMMAND_GATEWAY_BASE_URL=https://your-gateway.example.com
WA_COMMAND_GATEWAY_TOKEN=replace-with-gateway-WHATSAPP_EXTERNAL_TOKEN
WA_COMMAND_GATEWAY_TENANT=gateway
WA_COMMAND_GATEWAY_SESSION_ID=replace-with-command-session-uuid
WA_COMMAND_GATEWAY_WEBHOOK_SECRET=replace-with-shared-secret
# Optional CSV of additional notification sessions to reject as command session.
WA_COMMAND_RESERVED_SESSIONS=
